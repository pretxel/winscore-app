{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_URL",
    "SUPABASE_SERVICE_ROLE_KEY",
    "NEXT_PUBLIC_SITE_URL",
    "CRON_SECRET",
    "FOOTBALL_DATA_TOKEN",
    "NEWS_API_TOKEN",
    "NEWS_API_URL",
    "RESEND_API_KEY",
    "EMAIL_FROM",
    "EMAIL_REPLY_TO",
    "SEND_EMAIL_HOOK_SECRET",
    "OPENROUTER_API_KEY",
    "OPENROUTER_MODEL",
    "LEONARDO_API_KEY",
    "LEONARDO_MODEL",
    "LEONARDO_WEBHOOK_SECRET",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "NEXT_PUBLIC_FACEBOOK_APP_ID",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "WAGER_CLUSTER",
    "WAGER_RPC_URL",
    "WAGER_WS_URL",
    "WAGER_RPC_API_KEY",
    "WAGER_PROGRAM_ID",
    "WAGER_APPROVED_MINT",
    "WAGER_TOKEN_PROGRAM",
    "WAGER_UI_ENABLED",
    "WAGER_DEPOSITS_ENABLED",
    "WAGER_SETTLEMENT_ENABLED",
    "WAGER_AUTHORITY_KEYPAIR",
    "WAGER_SETTLEMENT_AUTHORITY"
  ],
  "tasks": {
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "biome.json"]
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "vitest.config.ts"]
    },
    "build": {
      "dependsOn": ["lint", "typecheck", "test"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
